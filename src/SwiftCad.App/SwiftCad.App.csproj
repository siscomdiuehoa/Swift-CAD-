<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <!-- CI: -p:SwiftCadPlatform=ios|android chi danh gia mot nen tang, de may chi can mot workload. -->
    <TargetFrameworks Condition="'$(SwiftCadPlatform)' == 'ios'">net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(SwiftCadPlatform)' == 'android'">net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>SwiftCad.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Ghim phien ban MAUI. Xem docs/architecture.md muc "Phien ban". -->
    <MauiVersion>10.0.130</MauiVersion>

    <ApplicationTitle>Swift CAD</ApplicationTitle>
    <!-- Ma dinh danh chinh thuc: trung voi ung dung "Swift CAD Viewer Pro" tren App Store Connect (Issue #4). -->
    <ApplicationId>vn.siscom.swiftcad</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <NeutralLanguage>en</NeutralLanguage>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Quyen Dang nhap voi Apple chi ap cho ban ky that (TestFlight/App Store). Ban simulator va ban kiem tra
       bien dich khong ky (EnableCodeSigning=false) khong dung tep nay vi entitlement bat buoc phai ky ma. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(RuntimeIdentifier)' == 'ios-arm64' and '$(EnableCodeSigning)' != 'false'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.Distribution.plist</CodesignEntitlements>
  </PropertyGroup>

  <!-- Bản dựng chụp ảnh cho CI: bật ShotMode để mở thẳng từng màn hình. Mặc định tắt. -->
  <PropertyGroup Condition="'$(SwiftCadShots)' == 'true'">
    <DefineConstants>$(DefineConstants);SWIFTCAD_SHOTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon da duyet (icon_swift_cad.png cua Owner, cat thanh hinh vuong tran vien).
         iOS: mot anh vuong, he dieu hanh tu bo goc. Android: icon thich ung, lop truoc thu nho de khong mat chu CAD o goc. -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="Resources\AppIcon\ios\appicon.png" />
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.56" Color="#011E50" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#E8F1F8" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.155.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwiftCad.Core\SwiftCad.Core.csproj" />
    <ProjectReference Include="..\SwiftCad.Cad\SwiftCad.Cad.csproj" />
  </ItemGroup>

</Project>
